# Use NVIDIA CUDA 12.1 DEVELOPMENT image (not runtime)
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    TORCH_CUDA_ARCH_LIST="6.0 6.1 7.0 7.5 8.0 8.6 8.9 9.0+PTX" \
    CMAKE_BUILD_PARALLEL_LEVEL=4

# Install system dependencies including full CUDA toolkit
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-venv \
    python3-pip \
    curl \
    git \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

WORKDIR /workspace

# Copy your fork
COPY . /workspace

# Install Soup from your local fork (editable mode)
# Bug fix: was missing the `ui` extra (fastapi/uvicorn) from pyproject.toml's
# own [project.optional-dependencies] and separately hand-installing gradio +
# raw fastapi/uvicorn/psutil below instead — pulling in an entirely different,
# disconnected web framework nothing in this image actually serves. Use the
# extra pyproject.toml already declares for this.
RUN pip install --no-cache-dir -e ".[train,serve,data,eval,ui]"

# Install quantization libraries with pre-compiled wheels where possible
# GPTQ: use pre-built wheel if available, otherwise compile
RUN pip install --no-cache-dir auto-gptq --extra-index-url https://huggingface.github.io/autogptq-index/whl/cu121/ || \
    pip install --no-cache-dir auto-gptq --no-build-isolation

# AWQ: usually has pre-built wheels
RUN pip install --no-cache-dir autoawq || \
    echo "Warning: autoawq installation failed, continuing without AWQ support"

# Optimum for additional quantization support
RUN pip install --no-cache-dir optimum

# llama-cpp-python with CUDA support
RUN CMAKE_ARGS="-DGGML_CUDA=on -DCUDA_DOCKER_ARCH=all" \
    pip install --no-cache-dir llama-cpp-python --no-build-isolation

# psutil for RAM-aware layer streaming / RAM-cache sizing (utils/layer_stream.py,
# memory/layer_cache.py). fastapi/uvicorn/gradio dropped: they duplicated the
# `ui` extra above, and gradio was never used by anything soup_cli actually
# imports — see soup_cli/ui/app.py (the real, FastAPI-based dashboard).
RUN pip install --no-cache-dir "psutil>=5.9.0"

EXPOSE 7860

# Bug fix: `python -m soup_cli.ui.app` never started a server — that module
# has no `__main__` guard (uvicorn.run lives in `soup_cli/commands/ui.py`,
# behind the real `soup ui` CLI command, which also generates+prints the
# Bearer auth token every mutating endpoint requires). The old entrypoint
# just imported the module and exited.
ENTRYPOINT ["soup", "ui", "--host", "0.0.0.0", "--port", "7860", "--no-browser"]